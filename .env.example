DATABASE_URL=postgresql+asyncpg://quant:quant@127.0.0.1:15432/quant_signal
API_HOST=127.0.0.1
API_PORT=18100
MCP_HOST=127.0.0.1
MCP_PORT=18101
MCP_TRANSPORT=streamable-http
MCP_STATELESS_HTTP=true
BACKTEST_POLL_SECONDS=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000

# Require an API key (Authorization: Bearer <key> or X-API-Key) on every
# /api/v1/* REST route and on the MCP streamable-http endpoint. Keep this
# false for local dev; set it true before exposing either service publicly.
# Create keys with: uv run quant-signal-manage-keys create --name <label>
API_AUTH_ENABLED=false

# Optional built-in LLM analyst. Any OpenAI-compatible endpoint can be used.
LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=12800
LLM_TIMEOUT_SECONDS=300

# Optional: a self-hosted SearxNG instance, reached through an authenticated
# proxy (see searxng-proxy/), used as a second, current-only news source
# alongside Google News RSS for `quant-signal-sync-data news`. Leave unset
# to use RSS only.
SEARXNG_PROXY_URL=
SEARXNG_PROXY_KEY=
