DATABASE_URL=postgresql+asyncpg://quant:quant@127.0.0.1:15432/quant_signal
API_HOST=127.0.0.1
API_PORT=18100
MCP_HOST=127.0.0.1
MCP_PORT=18101
MCP_TRANSPORT=streamable-http
MCP_STATELESS_HTTP=true
BACKTEST_POLL_SECONDS=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000

# Require an API key (Authorization: Bearer <key> or X-API-Key) on every
# /api/v1/* REST route and on the MCP streamable-http endpoint. Keep this
# false for local dev; set it true before exposing either service publicly.
# Create keys with: uv run quant-signal-manage-keys create --name <label>
API_AUTH_ENABLED=false

# Shared quote infrastructure. Enable the API after Redis and the collector are running.
QUOTES_ENABLED=false
QUOTES_REDIS_URL=redis://127.0.0.1:6379/0
QUOTES_MAX_SYMBOLS=200
# Set these only on the isolated collector service.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_SIMULATION=false
# Collector only: official minute backfill from Shioaji kbars (see deploy/quotes/README.md).
QUOTES_BACKFILL_ENABLED=true
QUOTES_BACKFILL_AFTER_CLOSE=13:55
QUOTES_BACKFILL_INTRADAY_MAX=150
QUOTES_BACKFILL_MAX_SYMBOLS=300

# Optional built-in LLM analyst.
#   LLM_PROVIDER=openai_compatible  any chat-completions server (LLM_BASE_URL / LLM_MODEL ...)
#   LLM_PROVIDER=anthropic          Claude via the Anthropic SDK (ANTHROPIC_* below)
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=12800
LLM_TIMEOUT_SECONDS=300

# Optional: an independent model for the debate's final synthesis call only
# (see DebateAnalysisService). Falls back to the same model as LLM_* above
# when disabled -- set this to reduce the risk of one model both arguing
# every side of the debate and then judging itself.
JUDGE_LLM_ENABLED=false
JUDGE_LLM_PROVIDER=openai_compatible
JUDGE_LLM_BASE_URL=http://host.docker.internal:11434/v1
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=local
JUDGE_LLM_TEMPERATURE=0.2
JUDGE_LLM_MAX_TOKENS=12800
JUDGE_LLM_TIMEOUT_SECONDS=300

# Claude (used when LLM_PROVIDER or JUDGE_LLM_PROVIDER is "anthropic").
# Keep the key in your secret store (Coolify environment variables), never in git.
# Current Claude models take no temperature, and max tokens also covers thinking,
# so the LLM_* temperature / max-token settings above do not apply to Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional different model for the debate judge; empty = ANTHROPIC_MODEL.
JUDGE_ANTHROPIC_MODEL=
# low | medium | high | xhigh | max  (thinking depth and token spend)
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_SECONDS=600

# Optional: a self-hosted SearxNG instance, reached through an authenticated
# proxy (see searxng-proxy/), used as a second, current-only news source
# alongside Google News RSS for `quant-signal-sync-data news`. Leave unset
# to use RSS only.
SEARXNG_PROXY_URL=
SEARXNG_PROXY_KEY=

# Frontend login gate (see POST /api/v1/auth/login). The dashboard exchanges
# this shared password for DASHBOARD_API_KEY, which it then attaches as
# Authorization: Bearer <key> on every request -- so this only does anything
# once API_AUTH_ENABLED=true and DASHBOARD_API_KEY is a real key created with
# quant-signal-manage-keys. Leave both empty to leave the login gate disabled.
DASHBOARD_PASSWORD=
DASHBOARD_API_KEY=

# Optional private Kronos model service; leave empty to use the statistical baseline only.
KRONOS_URL=
# Shared secret sent as Authorization: Bearer to the Kronos service. Set the same
# KRONOS_API_KEY on the service before exposing it beyond a private network.
KRONOS_API_KEY=

# Background exchange sync (runs inside the worker process; run ONE worker so the
# request throttle is not multiplied). Requests never call the exchanges: they
# queue a job and the worker fetches missing months once, then reuses the database.
# SYNC_DAILY_TIME is a comma-separated list of Taipei times; each triggers one refresh
# per weekday. The evening run picks up credit reports published after the close.
# SYNC_MARKET_LOOKBACK_DAYS is how far back the whole-market snapshot is first filled
# (about 3 requests per exchange per trading day; later runs only fetch new days).
SYNC_ENABLED=true
SYNC_DAILY_TIME=15:30,21:45
SYNC_MARKET_LOOKBACK_DAYS=520
SYNC_LOOKBACK_DAYS=500
# SYNC_MAX_ATTEMPTS=3
# SYNC_STALE_AFTER_SECONDS=1800

# Per-user watchlist size (signed-in Google users).
# WATCHLIST_MAX_ITEMS=25
